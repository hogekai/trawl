	},
	"files": ["dist"],
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"typescript": "^5.7.0",
		"tsup": "^8.0.0",
		"vitest": "^3.0.0"
	}
