{
	"name": "@trawl/core",
	"version": "0.1.0",
	"type": "module",
	"description": "Version-agnostic bid-collection pipeline for trawl",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/hogekai/trawl.git",
		"directory": "packages/core"
	},
	"keywords": ["openrtb", "bidding", "programmatic", "advertising"],
	"engines": {
		"node": ">=18"
	},
